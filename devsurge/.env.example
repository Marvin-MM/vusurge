# DevArena frontend environment template.
#
# Copy to .env.local for local development (gitignored). Every value here is
# read via import.meta.env at build/dev time — Vite only exposes variables
# prefixed VITE_ to client code.

# Base URL of the Innovation Management Platform backend's versioned API.
# Local development default matches the backend's own .env (PORT=5000).
VITE_API_BASE_URL=http://localhost:5000/api/v1
