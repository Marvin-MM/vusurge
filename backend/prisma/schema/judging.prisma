// Judging and evaluation (master prompt section 17): challenge staff
// (judges/mentors) invited without organization membership, versioned
// rubrics, judge-to-submission assignments, scorecards with server-computed
// weighted totals, and finalized/published results.

enum ChallengeStaffRoleDb {
  JUDGE
  MENTOR
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum StaffAssignmentStatus {
  ACTIVE
  REMOVED
}

enum JudgeAssignmentStatus {
  ASSIGNED
  CONFLICT_DECLARED
  RECUSED
  REASSIGNED
}

enum ScorecardStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum ResultSnapshotStatus {
  FINALIZED
  PUBLISHED
  RETRACTED
}

enum ResultSelectionType {
  WINNER
  FINALIST
  RANKED
  HONORABLE_MENTION
  DISQUALIFIED
}

/// Hashed single-use expiring token. No organization membership is granted
/// on acceptance (master prompt section 17.2).
model ChallengeStaffInvitation {
  id               String                @id @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  challengeId      String                @map("challenge_id") @db.Uuid
  role             ChallengeStaffRoleDb
  /// Optional binding: if set, only a session authenticated as this email may accept.
  email            String?               @db.VarChar(320)
  tokenHash        String                @unique @map("token_hash") @db.VarChar(128)
  status           StaffInvitationStatus @default(PENDING)
  invitedByUserId  String                @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?               @map("accepted_by_user_id") @db.Uuid
  expiresAt        DateTime              @map("expires_at") @db.Timestamptz(6)
  respondedAt      DateTime?             @map("responded_at") @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge Challenge @relation(fields: [challengeId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "staff_invitation_challenge_fk")

  @@unique([id, organizationId], map: "staff_invitation_id_org_uq")
  @@index([organizationId, challengeId, status], map: "staff_invitation_org_challenge_idx")
  @@map("challenge_staff_invitation")
}

/// The accepted, active (or removed) staff relationship itself.
model ChallengeStaffAssignment {
  id              String                @id @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  challengeId     String                @map("challenge_id") @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  role            ChallengeStaffRoleDb
  status          StaffAssignmentStatus @default(ACTIVE)
  invitationId    String?               @map("invitation_id") @db.Uuid
  removedByUserId String?               @map("removed_by_user_id") @db.Uuid
  removedAt       DateTime?             @map("removed_at") @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge        Challenge         @relation(fields: [challengeId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "staff_assignment_challenge_fk")
  judgeAssignments JudgeAssignment[]

  /// One staff relationship per (challenge, user): re-inviting an existing
  /// staff member is rejected rather than creating a duplicate row.
  @@unique([challengeId, userId], map: "staff_assignment_challenge_user_uq")
  @@unique([id, organizationId], map: "staff_assignment_id_org_uq")
  @@unique([id, organizationId, challengeId], map: "staff_assignment_scope_uq")
  @@index([organizationId, challengeId, status], map: "staff_assignment_org_challenge_idx")
  @@map("challenge_staff_assignment")
}

model Rubric {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  challengeId     String   @map("challenge_id") @db.Uuid
  name            String   @db.VarChar(200)
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge Challenge       @relation(fields: [challengeId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "rubric_challenge_fk")
  versions  RubricVersion[]

  @@unique([id, organizationId], map: "rubric_id_org_uq")
  @@unique([id, organizationId, challengeId], map: "rubric_scope_uq")
  @@index([organizationId, challengeId], map: "rubric_org_challenge_idx")
  @@map("rubric")
}

/// Immutable once judging starts or any scorecard is submitted against it.
/// Criteria are relational rows so ranges, uniqueness, weights, and score
/// references are enforced by PostgreSQL rather than JSON validation alone.
model RubricVersion {
  id                String    @id @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  rubricId          String    @map("rubric_id") @db.Uuid
  challengeId       String    @map("challenge_id") @db.Uuid
  version           Int
  totalWeight       Int       @map("total_weight")
  tieBreakPolicy    String?   @map("tie_break_policy") @db.VarChar(1000)
  judgeCommentRules String?   @map("judge_comment_rules") @db.VarChar(1000)
  isActive          Boolean   @default(false) @map("is_active")
  createdByUserId   String    @map("created_by_user_id") @db.Uuid
  activatedAt       DateTime? @map("activated_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  rubric     Rubric            @relation(fields: [rubricId, organizationId, challengeId], references: [id, organizationId, challengeId], onDelete: Cascade, map: "rubric_version_rubric_fk")
  criteria   RubricCriterion[]
  scorecards Scorecard[]

  @@unique([rubricId, version], map: "rubric_version_rubric_number_uq")
  @@unique([id, organizationId], map: "rubric_version_id_org_uq")
  @@unique([id, organizationId, challengeId], map: "rubric_version_scope_uq")
  @@index([organizationId, rubricId, isActive], map: "rubric_version_active_idx")
  @@map("rubric_version")
}

model RubricCriterion {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  rubricVersionId String   @map("rubric_version_id") @db.Uuid
  key             String   @db.VarChar(60)
  label           String   @db.VarChar(200)
  description     String?  @db.VarChar(1000)
  minScore        Int      @map("min_score")
  maxScore        Int      @map("max_score")
  weight          Int
  scoringAnchors  Json?    @map("scoring_anchors")
  displayOrder    Int      @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rubricVersion   RubricVersion    @relation(fields: [rubricVersionId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "rubric_criterion_version_fk")
  criterionScores CriterionScore[]

  @@unique([rubricVersionId, key], map: "rubric_criterion_version_key_uq")
  @@unique([rubricVersionId, displayOrder], map: "rubric_criterion_version_order_uq")
  @@unique([id, organizationId, rubricVersionId], map: "rubric_criterion_scope_uq")
  @@index([organizationId, rubricVersionId], map: "rubric_criterion_org_version_idx")
  @@map("rubric_criterion")
}

/// One judge-to-submission pairing. Reassignment creates a new row and marks
/// the old one REASSIGNED rather than mutating it, preserving history.
model JudgeAssignment {
  id                 String                @id @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  challengeId        String                @map("challenge_id") @db.Uuid
  staffAssignmentId  String                @map("staff_assignment_id") @db.Uuid
  submissionId       String                @map("submission_id") @db.Uuid
  status             JudgeAssignmentStatus @default(ASSIGNED)
  conflictDeclaredAt DateTime?             @map("conflict_declared_at") @db.Timestamptz(6)
  recusedAt          DateTime?             @map("recused_at") @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge       Challenge                @relation(fields: [challengeId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "judge_assignment_challenge_fk")
  staffAssignment ChallengeStaffAssignment @relation(fields: [staffAssignmentId, organizationId, challengeId], references: [id, organizationId, challengeId], onDelete: Cascade, map: "judge_assignment_staff_fk")
  submission      Submission               @relation(fields: [submissionId, organizationId, challengeId], references: [id, organizationId, challengeId], onDelete: Cascade, map: "judge_assignment_submission_fk")
  scorecard       Scorecard?

  /// A judge is assigned to a given submission at most once among LIVE
  /// (non-reassigned) assignments — enforced via a partial unique index in
  /// migration SQL, since Prisma cannot express a partial unique constraint.
  @@unique([id, organizationId], map: "judge_assignment_id_org_uq")
  @@unique([id, organizationId, challengeId], map: "judge_assignment_scope_uq")
  @@index([organizationId, challengeId, submissionId], map: "judge_assignment_org_challenge_submission_idx")
  @@index([organizationId, staffAssignmentId, status], map: "judge_assignment_org_staff_status_idx")
  @@map("judge_assignment")
}

/// One scorecard per judge assignment. Relational criterion scores reference
/// the exact criterion snapshot. `totalScore` and
/// `maxPossibleScore` are the exact integer weighted sums computed server
/// side at submit time — never a client-supplied total.
model Scorecard {
  id                String          @id @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  challengeId       String          @map("challenge_id") @db.Uuid
  judgeAssignmentId String          @map("judge_assignment_id") @db.Uuid
  rubricVersionId   String          @map("rubric_version_id") @db.Uuid
  status            ScorecardStatus @default(DRAFT)
  totalScore        Int?            @map("total_score")
  maxPossibleScore  Int?            @map("max_possible_score")
  submittedAt       DateTime?       @map("submitted_at") @db.Timestamptz(6)
  lockedAt          DateTime?       @map("locked_at") @db.Timestamptz(6)
  reopenedAt        DateTime?       @map("reopened_at") @db.Timestamptz(6)
  reopenReason      String?         @map("reopen_reason") @db.VarChar(1000)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  judgeAssignment JudgeAssignment  @relation(fields: [judgeAssignmentId, organizationId, challengeId], references: [id, organizationId, challengeId], onDelete: Cascade, map: "scorecard_assignment_fk")
  rubricVersion   RubricVersion    @relation(fields: [rubricVersionId, organizationId, challengeId], references: [id, organizationId, challengeId], onDelete: Restrict, map: "scorecard_rubric_version_fk")
  criterionScores CriterionScore[]

  @@unique([judgeAssignmentId, organizationId], map: "scorecard_assignment_org_uq")
  @@unique([judgeAssignmentId, organizationId, challengeId], map: "scorecard_assignment_scope_uq")
  @@unique([id, organizationId], map: "scorecard_id_org_uq")
  @@unique([id, organizationId, rubricVersionId], map: "scorecard_scope_uq")
  @@index([organizationId, challengeId, status], map: "scorecard_org_challenge_status_idx")
  @@map("scorecard")
}

model CriterionScore {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  scorecardId     String   @map("scorecard_id") @db.Uuid
  rubricVersionId String   @map("rubric_version_id") @db.Uuid
  criterionId     String   @map("criterion_id") @db.Uuid
  score           Int
  comment         String?  @db.VarChar(2000)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  scorecard Scorecard       @relation(fields: [scorecardId, organizationId, rubricVersionId], references: [id, organizationId, rubricVersionId], onDelete: Cascade, map: "criterion_score_scorecard_fk")
  criterion RubricCriterion @relation(fields: [criterionId, organizationId, rubricVersionId], references: [id, organizationId, rubricVersionId], onDelete: Restrict, map: "criterion_score_criterion_fk")

  @@unique([scorecardId, criterionId], map: "criterion_score_scorecard_criterion_uq")
  @@index([organizationId, rubricVersionId, criterionId], map: "criterion_score_org_criterion_idx")
  @@map("criterion_score")
}

/// One row per submission once results are finalized for a challenge.
/// Deliberately does not assume every challenge uses a strict numeric rank
/// (master prompt section 17.4): `rankLabel` is the display value
/// ("Winner", "Finalist", "Honorable Mention"), `rank` is optional.
model SubmissionResult {
  id                  String              @id @db.Uuid
  organizationId      String              @map("organization_id") @db.Uuid
  challengeId         String              @map("challenge_id") @db.Uuid
  snapshotId          String              @map("snapshot_id") @db.Uuid
  submissionId        String              @map("submission_id") @db.Uuid
  submissionVersionId String              @map("submission_version_id") @db.Uuid
  trackId             String?             @map("track_id") @db.Uuid
  selectionType       ResultSelectionType @default(RANKED) @map("selection_type")
  rankLabel           String?             @map("rank_label") @db.VarChar(120)
  rank                Int?
  /// Exact integer sum of every SUBMITTED/LOCKED scorecard's totalScore for
  /// this submission — never re-derived from floating-point aggregation.
  aggregateScore      Int?                @map("aggregate_score")
  tieBreakDecision    String?             @map("tie_break_decision") @db.VarChar(2000)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  challenge         Challenge         @relation(fields: [challengeId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "submission_result_challenge_fk")
  snapshot          ResultSnapshot    @relation(fields: [snapshotId, organizationId, challengeId], references: [id, organizationId, challengeId], onDelete: Restrict, map: "submission_result_snapshot_fk")
  submission        Submission        @relation(fields: [submissionId, organizationId, challengeId], references: [id, organizationId, challengeId], onDelete: Restrict, map: "submission_result_submission_fk")
  submissionVersion SubmissionVersion @relation(fields: [submissionVersionId, organizationId, challengeId, submissionId], references: [id, organizationId, challengeId, submissionId], onDelete: Restrict, map: "submission_result_version_fk")
  track             ChallengeTrack?   @relation(fields: [trackId, organizationId, challengeId], references: [id, organizationId, challengeId], onDelete: Restrict, map: "submission_result_track_fk")

  @@unique([challengeId, submissionId], map: "submission_result_challenge_submission_uq")
  @@unique([id, organizationId], map: "submission_result_id_org_uq")
  @@unique([snapshotId, submissionId], map: "submission_result_snapshot_submission_uq")
  @@index([organizationId, challengeId, rank], map: "submission_result_org_challenge_rank_idx")
  @@map("submission_result")
}

/// Immutable organizer decision set. Publication changes only the lifecycle
/// state of this snapshot; the selected submission-version rows never change.
model ResultSnapshot {
  id                 String               @id @db.Uuid
  organizationId     String               @map("organization_id") @db.Uuid
  challengeId        String               @map("challenge_id") @db.Uuid
  publicationVersion Int
  status             ResultSnapshotStatus @default(FINALIZED)
  finalizedByUserId  String               @map("finalized_by_user_id") @db.Uuid
  finalizedAt        DateTime             @default(now()) @map("finalized_at") @db.Timestamptz(6)
  publishedAt        DateTime?            @map("published_at") @db.Timestamptz(6)
  retractedAt        DateTime?            @map("retracted_at") @db.Timestamptz(6)
  retractionReason   String?              @map("retraction_reason") @db.VarChar(2000)

  challenge Challenge          @relation(fields: [challengeId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "result_snapshot_challenge_fk")
  finalizer User               @relation(fields: [finalizedByUserId], references: [id], onDelete: Restrict, map: "result_snapshot_finalizer_fk")
  decisions SubmissionResult[]

  @@unique([challengeId, publicationVersion], map: "result_snapshot_challenge_version_uq")
  @@unique([id, organizationId, challengeId], map: "result_snapshot_scope_uq")
  @@index([organizationId, challengeId, status], map: "result_snapshot_org_challenge_status_idx")
  @@map("result_snapshot")
}
