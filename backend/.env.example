##############################################################################
# Innovation Management Platform — backend environment template
#
# Names and documentation ONLY. This file is committed; it must never contain a
# real secret. Copy it to .env for local development, and supply production
# values from a secret manager rather than a file on disk.
#
# Every variable is validated at process startup. A missing or malformed
# required value aborts the process with an explicit message (exit code 78).
##############################################################################

# --- Application -----------------------------------------------------------
# development | test | staging | production
APP_ENV=development
# api | worker — selects the process role for logs, metrics, and readiness.
PROCESS_ROLE=api
SERVICE_NAME=innovation-platform-backend
# Surfaced in logs, traces, and the OpenAPI document. Set from your CI build.
BUILD_VERSION=0.1.0
# Canonical externally reachable URL of this API. Must be https in production.
PUBLIC_BASE_URL=http://localhost:3000
# Canonical URL of the web client. Used to build links in transactional email.
WEB_APP_BASE_URL=http://localhost:3001
HOST=0.0.0.0
PORT=3000
# Comma-separated origins allowed to make credentialed cross-origin requests.
# Must all be https in production. Prefer a same-site deployment and leave this
# as narrow as possible: a permissive origin defeats the cookie session model.
TRUSTED_ORIGINS=http://localhost:3001
# PRE-LAUNCH ONLY. Set to true in production while real users are not yet on
# the platform, to let a developer's local frontend (e.g. http://localhost:3000)
# call this API: loopback http origins become valid TRUSTED_ORIGINS entries,
# the https requirement on PUBLIC_BASE_URL is waived, and session cookies are
# relaxed for cross-site development. ONLY http://localhost / http://127.0.0.1
# / http://[::1] origins qualify — never a LAN IP or public domain. Browser
# cookie sessions still need the API itself on https; remove before launch.
ALLOW_INSECURE_ORIGINS=false
# Comma-separated proxy CIDRs. Leave empty when the API is reached directly.
TRUSTED_PROXY_CIDRS=
# Hard cap on request body size, in bytes.
MAX_REQUEST_BODY_BYTES=1048576
# Grace period for in-flight work during shutdown, in milliseconds.
SHUTDOWN_TIMEOUT_MS=25000

# --- PostgreSQL ------------------------------------------------------------
# One logical database. The application connects through DATABASE_URL (the
# pooled endpoint); Prisma migrations use DIRECT_DATABASE_URL when set (see
# below). For Neon, use the pooled endpoint with ?sslmode=require.
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST/CHANGE_ME_DB?sslmode=require
# Direct (non-pooled) endpoint for the outbox relay's PostgreSQL LISTEN/NOTIFY
# session. REQUIRED whenever DATABASE_URL goes through a transaction-mode
# pooler (Neon's `...-pooler...` endpoint, PgBouncer): LISTEN registration is
# session state, which a pooled session cannot hold. Same credentials and
# database as DATABASE_URL but the NON-pooled host (for Neon, the same URL
# with `-pooler` removed). Leave unset when DATABASE_URL is already a direct
# connection (typical for local Postgres).
# DATABASE_LISTENER_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_DIRECT_HOST/CHANGE_ME_DB?sslmode=require
# Direct (non-pooled) endpoint used ONLY by `prisma migrate deploy`. Prisma's
# migration advisory lock is session-scoped and is unreliable over a
# transaction-pooling proxy (Neon's `...-pooler...` host / PgBouncer in
# transaction mode), which shows up as a migration that starts then fails
# (P3009). Point this at the SAME database on the non-pooled host (for Neon,
# the same host with `-pooler` removed). Leave unset when DATABASE_URL already
# points at a direct connection (typical for local Postgres); the CLI falls
# back to DATABASE_URL.
# DIRECT_DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_DIRECT_HOST/CHANGE_ME_DB?sslmode=require
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Retries are applied ONLY to serialization/deadlock failures, never blindly.
DATABASE_MAX_SERIALIZATION_RETRIES=3
DATABASE_SLOW_QUERY_THRESHOLD_MS=500

# --- Testing (local development only) ---------------------------------------
# Optional. When set, `bun test` runs against this database instead of
# DATABASE_URL, keeping test data isolated from your dev database.
# The database name must contain the word "test".
# TEST_DATABASE_URL=postgresql://ip_app:ip_app_local_dev@127.0.0.1:55433/innovation_platform_test

# --- Authentication (Better Auth) ------------------------------------------
# At least 32 characters, from a cryptographic RNG. Rotating it invalidates
# every active session.
BETTER_AUTH_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
AUTH_BASE_PATH=/api/v1/auth
AUTH_SESSION_EXPIRES_IN_SECONDS=604800
AUTH_SESSION_UPDATE_AGE_SECONDS=86400
# How recently a user must have authenticated for sensitive actions (ownership
# transfer, role grants, MFA reset, sensitive exports) to be permitted.
AUTH_FRESH_SESSION_MAX_AGE_SECONDS=900
AUTH_COOKIE_PREFIX=ip
# Leave unset for host-only cookies, which is the safer default. Set it only if
# the API and web client are on different subdomains of one registrable domain.
# AUTH_COOKIE_DOMAIN=example.org

# --- OAuth providers -------------------------------------------------------
# Credentials are required only when the provider is enabled.
# Google redirect URI:  <PUBLIC_BASE_URL><AUTH_BASE_PATH>/callback/google
GOOGLE_OAUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub callback URL:  <PUBLIC_BASE_URL><AUTH_BASE_PATH>/callback/github
# Request only the default public scopes. Private repository scopes are
# deliberately NOT requested in this release.
GITHUB_OAUTH_ENABLED=false
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Redis -----------------------------------------------------------------
# Two SEPARATE deployments are required in production, not two databases on one
# server: the cache needs a TTL-friendly eviction policy while BullMQ requires
# maxmemory-policy=noeviction, and that policy is per-server.
CACHE_REDIS_URL=redis://127.0.0.1:56380
CACHE_REDIS_KEY_PREFIX=ip:cache:
CACHE_REDIS_COMMAND_TIMEOUT_MS=250
CACHE_CIRCUIT_BREAKER_THRESHOLD=5
CACHE_CIRCUIT_BREAKER_RESET_MS=10000
# BullMQ. Configure this server with maxmemory-policy=noeviction and
# persistence enabled.
QUEUE_REDIS_URL=redis://127.0.0.1:56381
QUEUE_REDIS_KEY_PREFIX=ip:queue

# --- Worker concurrency (bulkheads) ----------------------------------------
# Urgent transactional work is given its own budget so a burst of exports or
# analytics cannot starve security email.
WORKER_CONCURRENCY_EMAIL=10
WORKER_CONCURRENCY_NOTIFICATION_FANOUT=8
WORKER_CONCURRENCY_REMINDERS=4
WORKER_CONCURRENCY_INTEGRATIONS=4
WORKER_CONCURRENCY_ANALYTICS=2
WORKER_CONCURRENCY_EXPORTS=2
WORKER_CONCURRENCY_MEDIA_CLEANUP=2
WORKER_CONCURRENCY_CACHE_MAINTENANCE=2
WORKER_CONCURRENCY_OUTBOX_DISPATCH=1

# --- Transactional outbox --------------------------------------------------
OUTBOX_BATCH_SIZE=100
# Fallback sweep interval for the outbox relay. Dispatch itself is driven by
# PostgreSQL LISTEN/NOTIFY: the writer notifies inside the committing
# transaction, and the worker's relay wakes immediately. This interval only
# bounds the delay when a notification is missed (relay reconnect gap), so it
# can stay high. Delayed events (available_at in the future) are handled
# precisely: the relay wakes exactly when the next one becomes dispatchable.
OUTBOX_POLL_INTERVAL_MS=30000
# Events left ENQUEUED longer than this are reclaimed and retried.
OUTBOX_STALE_ENQUEUED_AFTER_MS=300000
OUTBOX_MAX_ATTEMPTS=10
WORKER_SCHEDULERS_ENABLED=true
RETENTION_SCHEDULER_EVERY_MS=3600000
# 5-minute cadence: these sweeps reconcile minute-scale staleness windows
# (5-minute outbox leases, 24-hour reminder lead), so tighter intervals mostly
# generate idle Redis traffic. Outbox recovery also does not wait for this
# timer — the relay's reconciliation notifies on reclaim.
RECONCILIATION_SCHEDULER_EVERY_MS=300000
REMINDER_SCHEDULER_EVERY_MS=300000
ANALYTICS_REPAIR_SCHEDULER_EVERY_MS=900000
REMINDER_LEAD_HOURS=24

# --- Email (Resend) --------------------------------------------------------
# Required in production: the platform sends security and legal email.
EMAIL_ENABLED=false
# RESEND_API_KEY=
# Use a dedicated transactional sending subdomain with SPF, DKIM and DMARC
# configured. Do NOT enable open/click tracking on authentication email.
EMAIL_FROM_ADDRESS=no-reply@localhost
EMAIL_FROM_NAME=Innovation Platform
# EMAIL_REPLY_TO_ADDRESS=support@example.org
# Required in production to verify delivery/bounce/complaint webhooks.
# RESEND_WEBHOOK_SECRET=
EMAIL_REQUEST_TIMEOUT_MS=10000
EMAIL_MAX_ATTEMPTS=5

# --- Cloudinary (images only) ----------------------------------------------
# Images only. Documents and exports go to S3-compatible storage instead.
CLOUDINARY_ENABLED=false
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Every backend-issued upload signature is confined to this folder root.
CLOUDINARY_FOLDER_PREFIX=innovation-platform
CLOUDINARY_UPLOAD_SIGNATURE_TTL_SECONDS=300
CLOUDINARY_PRIVATE_DELIVERY_TTL_SECONDS=900
CLOUDINARY_REQUEST_TIMEOUT_MS=10000

# --- S3-compatible private object storage ----------------------------------
# Holds generated exports and, when enabled, private uploaded documents. The
# bucket must be private and encrypted at rest.
OBJECT_STORAGE_ENABLED=true
# Omit for AWS S3; set for MinIO or another S3-compatible provider.
S3_ENDPOINT=http://127.0.0.1:9110
S3_REGION=us-east-1
S3_BUCKET=innovation-platform-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# AWS S3 supports this directly. Local MinIO needs KMS/KES before enabling it;
# production still requires encryption through this header or bucket defaults.
S3_SEND_SSE_HEADERS=false
S3_UPLOAD_URL_TTL_SECONDS=600
S3_DOWNLOAD_URL_TTL_SECONDS=300
S3_REQUEST_TIMEOUT_MS=10000

# --- Malware scanning ------------------------------------------------------
# Required whenever FEATURE_DOCUMENT_UPLOADS is true. The local compose stack
# exposes ClamAV on 53310; production should use a private, monitored scanner.
MALWARE_SCANNER_ENABLED=false
MALWARE_SCANNER_HOST=127.0.0.1
MALWARE_SCANNER_PORT=53310
MALWARE_SCANNER_TIMEOUT_MS=15000

# --- Feature gates ---------------------------------------------------------
# Optional capabilities. Secure defaults: off unless the supporting
# infrastructure is present and the product has decided to enable them.
FEATURE_SSE_NOTIFICATIONS=false
SSE_NOTIFICATION_HEARTBEAT_MS=15000
SSE_NOTIFICATION_POLL_MS=2000
SSE_NOTIFICATION_MAX_CONNECTIONS_PER_USER=3
SSE_NOTIFICATION_MAX_CONNECTIONS_PER_IP=10
FEATURE_DOCUMENT_UPLOADS=false
FEATURE_SLACK_INTEGRATION=false
FEATURE_DISCORD_INTEGRATION=false
FEATURE_UNLISTED_CHALLENGES=true
FEATURE_OPEN_AUTHENTICATED_PARTICIPATION=true
FEATURE_MENTOR_ROLE=true
FEATURE_DIRECT_INNOVATION_INTAKE=true
# Serves the browsable API console. The specification stays exportable either
# way; default off in production.
FEATURE_OPENAPI_UI=true

# --- Upload limits ---------------------------------------------------------
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_DOCUMENT_BYTES=26214400
# Hard product limit; also enforced in the database.
UPLOAD_MAX_SUBMISSION_SCREENSHOTS=4
UPLOAD_ALLOWED_IMAGE_MIME_TYPES=image/png,image/jpeg,image/webp,image/gif
UPLOAD_ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/csv

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
# When Redis is unavailable, high-risk policies (credentials, join codes,
# invitation tokens) deny rather than allow. Do not turn this off.
RATE_LIMIT_FAIL_CLOSED_ON_HIGH_RISK=true
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_MAX_REQUESTS=120

# --- Pagination ------------------------------------------------------------
PAGINATION_DEFAULT_PAGE_SIZE=25
PAGINATION_MAX_PAGE_SIZE=100

# --- Encryption ------------------------------------------------------------
# Base64-encoded 32 bytes, used to seal integration webhook credentials at rest
# with AES-256-GCM. Generate with:  openssl rand -base64 32
ENCRYPTION_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES
# Increment when rotating the master key. Existing values record the version
# they were sealed with, so rotation does not require a flag day.
ENCRYPTION_KEY_VERSION=1

# --- Observability ---------------------------------------------------------
LOG_LEVEL=debug
# Must be false in production: logs have to stay machine-parseable.
LOG_PRETTY=false
OTEL_TRACING_ENABLED=false
OTEL_METRICS_ENABLED=false
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
# Prometheus scrape listener. Bind to an internal interface only: it is
# deliberately outside the public API namespace and must not be exposed.
# METRICS_PROMETHEUS_PORT=9464
METRICS_PROMETHEUS_HOST=127.0.0.1

# --- Data retention --------------------------------------------------------
# These are ENGINEERING DEFAULTS, not legal advice. Operators must set each
# window from their own jurisdiction and organizational policy before launch.
# See docs/retention.md.
RETENTION_EXPIRED_INVITATION_DAYS=90
RETENTION_REJECTED_APPLICATION_DAYS=365
RETENTION_EXPORT_FILE_DAYS=7
RETENTION_EMAIL_EVENT_DAYS=90
RETENTION_IDEMPOTENCY_RECORD_HOURS=48
RETENTION_WEBHOOK_RECEIPT_DAYS=30
RETENTION_RESOLVED_SUPPORT_TICKET_DAYS=365
RETENTION_UNCLAIMED_MEDIA_HOURS=24
RETENTION_NOTIFICATION_DAYS=180
RETENTION_AUDIT_EVENT_DAYS=2555
ACCOUNT_DELETION_GRACE_DAYS=14
ACCOUNT_DELETION_BATCH_SIZE=100
